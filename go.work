// One module per deployable or replaceable part keeps the public core free of
// database and HTTP drivers. A consumer adds golem/core and one store
// module, and inherits no driver belonging to the others. The module boundary
// keeps optional integrations out of binaries that do not use them.
//
// go.work exists for development inside this repository only. It is ignored
// when another module requires a published golem module, so local paths here
// never reach consumers.
go 1.26

use (
	./app
	./cmd
	./connector/feishu
	./core
	./internal
	./sandbox/docker
	./sandbox/kubernetes
	./store/mongodb
	./store/redis
	./store/sqlx
	./test
)

// The individual go.mod files keep published module requirements. These local
// replaces make the workspace test those modules against the checkout without
// teaching downstream consumers to use repository-relative paths.
replace github.com/ishi-o/golem/core v0.0.0 => ./core

replace github.com/ishi-o/golem/cmd v0.0.0 => ./cmd

replace github.com/ishi-o/golem/connector/feishu v0.0.0 => ./connector/feishu

replace github.com/ishi-o/golem/internal v0.0.0 => ./internal

replace github.com/ishi-o/golem/store/sqlx v0.0.0 => ./store/sqlx

replace github.com/ishi-o/golem/store/mongodb v0.0.0 => ./store/mongodb

replace github.com/ishi-o/golem/store/redis v0.0.0 => ./store/redis

replace github.com/ishi-o/golem/sandbox/docker v0.0.0 => ./sandbox/docker

replace github.com/ishi-o/golem/sandbox/kubernetes v0.0.0 => ./sandbox/kubernetes
